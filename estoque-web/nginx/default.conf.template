# Serve o build estático e faz o papel do proxy do Vite: /api/* → estoque-service, mesma origem, sem CORS.
# API_UPSTREAM vem do ambiente (envsubst da imagem do nginx); as variáveis do nginx ficam intactas.
server {
    listen 8080;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # DNS do Docker reconsultado a cada requisição: o nginx sobe mesmo com o estoque fora do ar
    # e acompanha o IP novo se o contêiner for recriado.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api ${API_UPSTREAM};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Arquivos com hash no nome: cache longo. O index.html nunca fica em cache.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
