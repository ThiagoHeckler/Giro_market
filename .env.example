# Copie para .env (fora do git) e preencha. O compose e os serviços Java (em dev) leem daqui.

# Tokens entre serviços: cada serviço exige o seu em Authorization: Bearer; quem chama manda o do destino.
# Gere cada um com: openssl rand -hex 32
ESTOQUE_TOKEN_SERVICO=
MERCADO_TOKEN_SERVICO=

# Operador do painel do estoque e do cadastro de produtos no mercado (senha com 8+ caracteres).
OPERADOR_USUARIO=operador
OPERADOR_SENHA=

# Opcional: sem chave, o tag-worker classifica por palavras-chave.
GROQ_API_KEY=

# Portas no host (padrões abaixo).
# ESTOQUE_PORTA=18081
# MERCADO_PORTA=18080
# VITRINE_PORTA=15173
# ESTOQUE_WEB_PORTA=15174
# TAG_WORKER_PORTA=18000
# ESTOQUE_DB_PORTA=15433
# MERCADO_DB_PORTA=15434
